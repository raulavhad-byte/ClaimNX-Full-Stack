NODE_ENV=development
PORT=3000

# Required backend services
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_MAX_LIFETIME_HOURS=12

# Optional frontend origin for production CORS
FRONTEND_ORIGIN=http://localhost:5173

# Mailbox OAuth (server-only; register these callbacks exactly with each provider)
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/email/oauth/gmail/callback
GMAIL_OAUTH_STATE_SECRET=replace-with-a-long-random-secret
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT_ID=common
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3000/email/microsoft/oauth/callback
YAHOO_OAUTH_CLIENT_ID=
YAHOO_OAUTH_CLIENT_SECRET=
YAHOO_OAUTH_REDIRECT_URI=http://localhost:3000/email/yahoo/oauth/callback
EMAIL_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Backend-only mailbox synchronization controls. Gmail/Graph use event-driven
# sync; these values govern renewal, recovery, and generic IMAP fallback.
EMAIL_SYNC_ENABLED=true
EMAIL_SYNC_TICK_INTERVAL_MS=30000
EMAIL_SYNC_IMAP_POLL_INTERVAL_MS=300000
EMAIL_SYNC_RECONCILIATION_INTERVAL_MS=1800000
EMAIL_SYNC_IDLE_BACKOFF_MAX_MS=1200000
EMAIL_SYNC_RETRY_MAX_ATTEMPTS=6
EMAIL_SYNC_WEBHOOK_RENEWAL_BUFFER_MS=86400000
EMAIL_SYNC_BATCH_SIZE=100
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT=

# Central active mailbox used to send automated reports (mail_accounts.id or email address).
CLAIMNX_AUTOMATION_MAILBOX_ID=

# Server-side Gemini policy analysis. Keep the key only in backend secrets;
# enabling this sends extracted policy text to Gemini for review-required JSON.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OCR runs only in the backend. The default is free/self-hosted Tesseract.
# Install Tesseract and Poppler on the backend server; leave paths blank when
# their executables are available through PATH. Never put these in frontend variables.
OCR_PROVIDER=TESSERACT_LOCAL
TESSERACT_PATH=
TESSERACT_LANGUAGES=eng
# 11 works best for scattered text on insurance cards; test 6 for uniform forms.
TESSERACT_PAGE_SEGMENTATION_MODE=11
PDFTOTEXT_PATH=
PDFTOPPM_PATH=

# Optional legacy cloud adapter. This is usage-billed and disabled by default.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
