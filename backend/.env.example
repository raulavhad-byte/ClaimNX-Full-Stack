NODE_ENV=development
PORT=3000

# Required backend services
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_MAX_LIFETIME_HOURS=12

# Optional frontend origin for production CORS
FRONTEND_ORIGIN=http://localhost:5173

# Mailbox OAuth (server-only; register these callbacks exactly with each provider)
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/email/oauth/gmail/callback
GMAIL_OAUTH_STATE_SECRET=replace-with-a-long-random-secret
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT_ID=common
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3000/email/microsoft/oauth/callback
YAHOO_OAUTH_CLIENT_ID=
YAHOO_OAUTH_CLIENT_SECRET=
YAHOO_OAUTH_REDIRECT_URI=http://localhost:3000/email/yahoo/oauth/callback
EMAIL_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Optional server-side AI integration key
# GEMINI_API_KEY=
